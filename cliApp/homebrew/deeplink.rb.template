class Deeplink < Formula
  desc "Open and test deeplinks on Android devices and iOS simulators"
  homepage "https://github.com/FelipeKoga/deeplink-launcher/blob/main/docs/CLI.md"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/FelipeKoga/deeplink-launcher/releases/download/cli-v{{VERSION}}/deeplink-{{VERSION}}-macos-arm64.tar.gz"
      sha256 "{{SHA256_MACOS_ARM64}}"
    end
    on_intel do
      url "https://github.com/FelipeKoga/deeplink-launcher/releases/download/cli-v{{VERSION}}/deeplink-{{VERSION}}-macos-x64.tar.gz"
      sha256 "{{SHA256_MACOS_X64}}"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/FelipeKoga/deeplink-launcher/releases/download/cli-v{{VERSION}}/deeplink-{{VERSION}}-linux-x64.tar.gz"
      sha256 "{{SHA256_LINUX_X64}}"
    end
  end

  def install
    bin.install "deeplink"
  end

  test do
    assert_match "scheme", shell_output("#{bin}/deeplink parse myapp://product/42")
    assert_match version.to_s, shell_output("#{bin}/deeplink --version")
  end
end
