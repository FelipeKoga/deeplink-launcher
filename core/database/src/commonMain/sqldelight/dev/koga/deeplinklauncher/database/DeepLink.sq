import kotlinx.datetime.LocalDateTime;

CREATE TABLE deeplink(
  id TEXT PRIMARY KEY,
  link TEXT NOT NULL UNIQUE,
  name TEXT,
  description TEXT,
  createdAt INTEGER AS LocalDateTime NOT NULL,
  lastLaunchedAt INTEGER AS LocalDateTime,
  folderId TEXT,
  isFavorite INTEGER DEFAULT 0,
  targetPackage TEXT,
  FOREIGN KEY(folderId) REFERENCES folder(id) ON UPDATE CASCADE
);

selectAllDeeplinks:
SELECT d.*, f.*
FROM deeplink d
LEFT JOIN folder f ON d.folderId = f.id
ORDER BY d.lastLaunchedAt DESC, d.createdAt DESC, d.name ASC;

deleteDeeplinkById:
DELETE FROM deeplink WHERE id = ?;

updateDeeplink:
UPDATE deeplink
SET link = :link, name = :name, description = :description, createdAt = :createdAt,
    lastLaunchedAt = :lastLaunchedAt, isFavorite = :isFavorite, folderId = :folderId,
    targetPackage = :targetPackage
WHERE id = :id AND NOT EXISTS (SELECT 1 FROM deeplink WHERE link = :link AND id <> :id);

selectOtherDeeplinkIdByLink:
SELECT id FROM deeplink WHERE link = :link AND id <> :id;

insertDeeplink:
INSERT INTO deeplink (id, link, name, description, createdAt, lastLaunchedAt, isFavorite, folderId, targetPackage)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateLastLaunchedAt:
UPDATE deeplink SET lastLaunchedAt = ? WHERE id = ?;

getDeepLinkByLink:
SELECT d.*, f.*
FROM deeplink d
LEFT JOIN folder f ON d.folderId = f.id
WHERE d.link = ?;

getDeepLinkById:
SELECT d.*, f.*
FROM deeplink d
LEFT JOIN folder f ON d.folderId = f.id
WHERE d.id = ?;

deleteAllDeeplinks:
DELETE FROM deeplink;