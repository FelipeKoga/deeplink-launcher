import kotlinx.datetime.LocalDateTime;

CREATE TABLE deeplink(
  id TEXT PRIMARY KEY,
  link TEXT NOT NULL UNIQUE,
  name TEXT,
  description TEXT,
  createdAt INTEGER AS LocalDateTime NOT NULL,
  lastLaunchedAt INTEGER AS LocalDateTime,
  folderId TEXT,
  isFavorite INTEGER DEFAULT 0,
  targetPackage TEXT,
  FOREIGN KEY(folderId) REFERENCES folder(id) ON UPDATE CASCADE
);

selectAllDeeplinks:
SELECT d.*, f.*
FROM deeplink d
LEFT JOIN folder f ON d.folderId = f.id
ORDER BY d.lastLaunchedAt DESC, d.createdAt DESC, d.name ASC;

selectAllDeeplinkIds:
SELECT id FROM deeplink;

deleteDeeplinkById:
DELETE FROM deeplink WHERE id = ?;

insertDeeplink:
INSERT INTO deeplink (id, link, name, description, createdAt, lastLaunchedAt, isFavorite, folderId, targetPackage)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

countDeeplinksById:
SELECT COUNT(*) FROM deeplink WHERE id = ?;

countOtherDeeplinksWithLink:
SELECT COUNT(*) FROM deeplink WHERE link = :link AND id != :id;

updateLink:
UPDATE deeplink SET link = :link WHERE id = :id;

updateName:
UPDATE deeplink SET name = :name WHERE id = :id;

updateDescription:
UPDATE deeplink SET description = :description WHERE id = :id;

updateTargetPackage:
UPDATE deeplink SET targetPackage = :targetPackage WHERE id = :id;

updateFavorite:
UPDATE deeplink SET isFavorite = :isFavorite WHERE id = :id;

updateFolder:
UPDATE deeplink SET folderId = :folderId WHERE id = :id;

updateLastLaunchedAt:
UPDATE deeplink SET lastLaunchedAt = :lastLaunchedAt WHERE id = :id;

updateImportedFields:
UPDATE deeplink
SET name = :name,
    description = :description,
    createdAt = :createdAt,
    isFavorite = :isFavorite,
    folderId = :folderId,
    targetPackage = :targetPackage
WHERE id = :id;

getDeepLinkByLink:
SELECT d.*, f.*
FROM deeplink d
LEFT JOIN folder f ON d.folderId = f.id
WHERE d.link = ?;

getDeepLinkById:
SELECT d.*, f.*
FROM deeplink d
LEFT JOIN folder f ON d.folderId = f.id
WHERE d.id = ?;

deleteAllDeeplinks:
DELETE FROM deeplink;
